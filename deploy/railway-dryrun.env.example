# Copy to railway-dryrun.env and fill values (file is gitignored).
# Map from src/main/resources/application.properties → application-prod.properties env names.
# Do NOT commit railway-dryrun.env.

SPRING_PROFILES_ACTIVE=prod

# --- PostgreSQL (Railway Postgres plugin — use References in dashboard, or these after linking) ---
# In Railway UI: Backend service → Variables → Add Reference → Postgres → PGHOST, PGPORT, etc.
SPRING_DATASOURCE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
SPRING_DATASOURCE_USERNAME=${{Postgres.PGUSER}}
SPRING_DATASOURCE_PASSWORD=${{Postgres.PGPASSWORD}}

# --- Required in prod (ProductionEnvironmentValidator) ---
JWT_SECRET=CHANGE_ME
GOOGLE_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,https://frontend-interview-scheduler.vercel.app

# --- JWT / auth cookies ---
JWT_ACCESS_EXPIRATION_MS=900000
AUTH_REFRESH_TOKEN_EXPIRATION_MS=2592000000
AUTH_REFRESH_TOKEN_COOKIE_NAME=mitra_refresh_token
AUTH_REFRESH_TOKEN_COOKIE_SECURE=true
AUTH_REFRESH_TOKEN_COOKIE_SAMESITE=None

# --- Google OAuth / Calendar ---
GOOGLE_CLIENT_SECRET=CHANGE_ME
GOOGLE_CALENDAR_REDIRECT_URI=https://YOUR-BACKEND.up.railway.app/api/integrations/google-calendar/callback
GOOGLE_WORKSPACE_DOMAIN=mitrai.com
GOOGLE_CALENDAR_ENCRYPTION_KEY=CHANGE_ME
GOOGLE_CALENDAR_REQUIRED=true
APP_FRONTEND_URL=https://frontend-interview-scheduler.vercel.app

# --- Gmail SMTP ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-email@gmail.com
SPRING_MAIL_PASSWORD=your-app-password

# --- Google Shared Drive (Railway has no local file path — use base64 JSON) ---
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("path\to\service-account.json"))
GOOGLE_RECRUITMENT_SHARED_DRIVE_ID=CHANGE_ME
GOOGLE_RECRUITMENT_SERVICE_ACCOUNT_KEY_BASE64=CHANGE_ME
GOOGLE_RECRUITMENT_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_RECRUITMENT_IMPERSONATE_USER=
GOOGLE_RECRUITMENT_ENFORCE_DOMAIN=false

# --- Misc ---
NOTIFICATION_EMAIL_ENABLED=true
SERVER_FORWARD_HEADERS_STRATEGY=native
