spring.application.name=Scheduler Backend

# Datasource
# Copy this file to application.properties and fill in local values.
# application.properties is gitignored — do not commit secrets.
spring.datasource.url=jdbc:postgresql://localhost:5432/interview_db_local
spring.datasource.username=postgres
spring.datasource.password=CHANGE_ME
spring.datasource.driver-class-name=org.postgresql.Driver

# Connection pool (HikariCP)
# Without these, idle connections are dropped by the DB after ~10 min
# causing "connection closed" errors that look like data loss on the frontend.
spring.datasource.hikari.minimum-idle=2
spring.datasource.hikari.maximum-pool-size=10
spring.datasource.hikari.idle-timeout=600000
spring.datasource.hikari.max-lifetime=1800000
spring.datasource.hikari.connection-timeout=30000
spring.datasource.hikari.connection-test-query=SELECT 1
spring.datasource.hikari.keepalive-time=300000

# JPA / Hibernate
# NEVER use create / create-drop / update in production — Flyway owns the schema
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.format_sql=false
spring.jpa.properties.hibernate.default_batch_fetch_size=16
spring.jpa.open-in-view=false

# Flyway
spring.flyway.enabled=true
spring.flyway.locations=classpath:db/migration
spring.flyway.repair=false
spring.flyway.validate-on-migrate=true

# Security / JWT
# Generate a strong secret for each environment (do not reuse examples)
jwt.secret=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
jwt.expiration-ms=86400000

# Mail
spring.mail.host=smtp.gmail.com
spring.mail.port=587
spring.mail.username=your-email@gmail.com
spring.mail.password=your-app-password
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

# Server
server.port=8080

# CORS (comma-separated). Add your Vercel frontend URL in production.
app.cors.allowed-origins=http://localhost:5173,http://localhost:3000

# Multipart uploads (candidate documents — max 10 MB per file in CandidateService)
spring.servlet.multipart.enabled=true
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB
server.tomcat.max-http-form-post-size=10MB
server.tomcat.max-swallow-size=-1

google.client.id=YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com
google.client.secret=YOUR_GOOGLE_CLIENT_SECRET
google.calendar.redirect-uri=http://localhost:8080/api/integrations/google-calendar/callback
google.workspace.domain=yourcompany.com
google.calendar.encryption-key=CHANGE_ME_TO_32_BYTE_BASE64_OR_HEX_KEY
google.calendar.required=true
app.frontend.url=http://localhost:5173

# Logging
logging.level.org.springframework.security=WARN
logging.level.com.nemal.security=INFO
logging.level.com.nemal=INFO

# Internal notifications
notification.reminder.lead-minutes=60
notification.reminder.cron=0 */15 * * * *
notification.retention.days=15
notification.retention.cron=0 0 12 * * *
notification.email.enabled=true

# Outbound email delivery logs (admin audit trail)
email.log.retention.days=15
email.log.retention.cron=0 0 12 * * *
