# ─────────────────────────────────────────────────────────────────────────────
# Interview Scheduler backend — environment variables for hosting (prod profile)
#
# Copy the keys into your host's environment settings (DockHosting, Railway, ...).
# Never commit real values. REQUIRED = the app will not start without it.
# Generate secrets with:  openssl rand -base64 64
#   (PowerShell: [Convert]::ToBase64String((1..64 | % { [byte](Get-Random -Max 256) })))
# ─────────────────────────────────────────────────────────────────────────────

SPRING_PROFILES_ACTIVE=prod
# Port the app listens on; most hosts inject this automatically.
PORT=8080

# ── Database (PostgreSQL) ── REQUIRED ───────────────────────────────────────
# JDBC URL. In prod, sslmode=require is appended automatically when missing,
# so the database must accept TLS connections.
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/your-db-name
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me
# Alternative to the three above (Railway style): postgres://user:pass@host:5432/db
# DATABASE_URL=
# DATABASE_PRIVATE_URL=

# ── Auth / JWT ── REQUIRED ──────────────────────────────────────────────────
# Long random secret (64+ bytes, base64). Rotate if it is ever exposed.
JWT_SECRET=generate-a-long-random-secret
# Access token lifetime (default 15 minutes)
JWT_ACCESS_EXPIRATION_MS=900000

# Refresh token cookie. SameSite=None + Secure=true is required when the frontend
# and API are on different sites (e.g. vercel.app + dockhosting.dev).
AUTH_REFRESH_TOKEN_EXPIRATION_MS=2592000000
AUTH_REFRESH_TOKEN_COOKIE_NAME=mitra_refresh_token
AUTH_REFRESH_TOKEN_COOKIE_SECURE=true
AUTH_REFRESH_TOKEN_COOKIE_SAMESITE=None

# ── Frontend / CORS ── REQUIRED ─────────────────────────────────────────────
# Comma-separated list of exact frontend origins (no trailing slash)
APP_CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# Where Google Calendar connect/disconnect redirects users back to
APP_FRONTEND_URL=https://your-frontend.vercel.app

# ── Google sign-in ── REQUIRED ──────────────────────────────────────────────
# Must be the same OAuth client ID the frontend uses (VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Company Workspace domain. When set, only @domain accounts can register or use
# Google sign-in. Leave empty in local/dev to allow any account.
GOOGLE_WORKSPACE_DOMAIN=mitrai.com

# ── Google Calendar integration ─────────────────────────────────────────────
GOOGLE_CLIENT_SECRET=
# Must also be listed as an authorized redirect URI on the OAuth client
GOOGLE_CALENDAR_REDIRECT_URI=https://your-backend-host/api/integrations/google-calendar/callback
# RECOMMENDED: encrypts stored Google Calendar tokens. If empty, a built-in dev key
# is used, which is public. Changing it later means users must reconnect Calendar.
GOOGLE_CALENDAR_ENCRYPTION_KEY=generate-a-long-random-secret
GOOGLE_CALENDAR_REQUIRED=false

# ── Recruitment Shared Drive (optional) ─────────────────────────────────────
GOOGLE_RECRUITMENT_SHARED_DRIVE_ID=
# Service-account JSON key: provide either the base64 content or a file path
GOOGLE_RECRUITMENT_SERVICE_ACCOUNT_KEY_BASE64=
GOOGLE_RECRUITMENT_SERVICE_ACCOUNT_KEY_PATH=
GOOGLE_RECRUITMENT_IMPERSONATE_USER=
GOOGLE_RECRUITMENT_ENFORCE_DOMAIN=false

# ── Email (SMTP) — needed for notifications and welcome emails ──────────────
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
# Gmail: use an App Password, not the account password
SPRING_MAIL_PASSWORD=
NOTIFICATION_EMAIL_ENABLED=true
EMAIL_LOG_RETENTION_DAYS=15
EMAIL_LOG_RETENTION_CRON=0 0 12 * * *

# ── Security tuning (optional, defaults shown) ──────────────────────────────
SECURITY_RATE_LIMIT_AUTH_REQUESTS_PER_MINUTE=20
SECURITY_RATE_LIMIT_SESSION_REQUESTS_PER_MINUTE=60
SECURITY_RATE_LIMIT_SENSITIVE_WRITES_PER_MINUTE=120
# true when running behind the host's reverse proxy (DockHosting/Railway)
SECURITY_RATE_LIMIT_TRUST_FORWARDED_FOR=true
SERVER_FORWARD_HEADERS_STRATEGY=native
# SECURITY_HEADERS_CSP=default-src 'self'; ...
